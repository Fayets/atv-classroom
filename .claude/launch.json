{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "classroom-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev", "--", "--port", "5177"],
      "port": 5177
    },
    {
      "name": "classroom-mock",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev:mock"],
      "port": 5173
    },
    {
      "name": "classroom-backend",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "main:app", "--app-dir", "backend", "--port", "8000"],
      "port": 8000
    }
  ]
}
