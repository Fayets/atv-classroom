# Copiar a /etc/atv-backup.env (chmod 600) y completar.

# El .env del backend del classroom: de ahí salen DB_HOST, DB_USER, DB_PASSWORD y DB_NAME de Neon.
ENV_DB=/opt/atv-classroom/backend/.env

# Dónde quedan los dumps en el VPS (30 diarios + uno por mes durante un año).
LOCAL_DIR=/var/backups/atv

# Opcional: remoto cifrado de rclone (crypt) que apunta a la carpeta "Backups ATV" del Drive.
# Vacío = solo en el VPS.
REMOTO=

# Carpeta del VPS donde el contenedor del backend guarda los adjuntos del chat.
ADJUNTOS_DIR=

# A quién avisa Theo si el backup falla.
AVISAR_A=+5493804219551
